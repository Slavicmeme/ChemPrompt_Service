# ============================================================================
# ChemPrompt — Docker compose settings (.env)
# ============================================================================

# 1) 데이터 저장 위치 (호스트 폴더 → 컨테이너에 연결)
#    ${DATA_DIR}/postgres : DB 데이터,  ${DATA_DIR}/storage : 모델·데이터셋·embedding 파일,  ${DATA_DIR}/llm : Aya LLM 파일
#    폴더를 미리 만들어 두면 생기는 파일이 그 폴더 소유자 계정으로 만들어짐 (mkdir -p <DATA_DIR>/storage)
DATA_DIR=./data

# 2) 외부 접속: 이 컴퓨터의 IP와 포트 → nginx(:80)로 포워딩 (0.0.0.0 = 모든 네트워크)
WEB_HOST=0.0.0.0
WEB_PORT=8889

# 3) DB 계정: compose 안의 PostgreSQL이 이 ID/PW로 만들어지고, api/init도 같은 값으로 접속
POSTGRES_USER=chemprompt
POSTGRES_PASSWORD=
POSTGRES_DB=chemprompt

# ----------------------------------------------------------------------------
# (선택) 비워 두면 config/docker-compose.yml의 기본값을 씀 — 괄호 안이 기본값
# ----------------------------------------------------------------------------

# Agent (OpenAI) — OPENAI_API_KEY가 비어 있으면 Agent 기능이 꺼짐
OPENAI_API_KEY=
# Agent 모델 (gpt-4o-mini)
OPENAI_AGENT_MODEL=
# reasoning 모델용 강도: none | minimal | low | medium | high (비우면 보내지 않음)
OPENAI_REASONING_EFFORT=

# 관리자 자동 생성 — 둘 다 있으면 init이 첫 실행 때 만듦 (admin / 비우면 만들지 않음)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 세션 토큰 해시용 비밀값, 바꾸면 기존 로그인이 끊김 (비우면 경고만 남김)
SECRET_KEY=

# 예측/학습
# representation: http(Aya GPU, 실전) | mock(개발용 CPU embedding) (http)
REPRESENTATION_MODE=
# GA: genetic(원본 GA, 실전) | mock(개발용) (genetic)
GA_MODE=
# init의 built-in 모델 학습 설정: FULL | FEATURE_SELECTION | GENETIC (FULL), RANDOM | SCAFFOLD (RANDOM)
BUILTIN_DESCRIPTOR_MODE=
BUILTIN_SPLIT=
# 동시에 돌 수 있는 학습 수 (2)
TRAINING_WORKERS=

# Aya (GPU) — 내부 aya 컨테이너가 자동으로 함께 뜸 (REPRESENTATION_MODE=http, NVIDIA Container Toolkit 필요)
# 사용할 GPU 번호, 여러 개면 쉼표로 (0 / 예: 0,1) — GPU마다 모델을 하나씩 올려 나눠 처리함 (GPU당 약 18GB)
AYA_GPUS=
# Hugging Face token — Aya는 라이선스 동의가 필요한 모델이라, 처음에 <DATA_DIR>/llm으로 받을 때 필요함
HF_TOKEN=
# 모델 ID (CohereLabs/aya-expanse-8b), dtype float16 | float32 (float16), 오프라인 1 | 0 (0 = 없으면 내려받음)
AYA_MODEL_ID=
AYA_DTYPE=
HF_HUB_OFFLINE=

# Langfuse tracing — 키가 비어 있으면 꺼짐 (base url: https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
